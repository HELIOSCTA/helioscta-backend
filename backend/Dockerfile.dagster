FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for pyodbc
RUN apt-get update && apt-get install -y \
    unixodbc-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install pendulum binary wheel first to avoid build issues
RUN pip install --no-cache-dir pendulum --only-binary :all:

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only runtime sources needed by Dagster instead of the full repository
COPY backend/setup.py ./
COPY backend ./backend

RUN pip install -e . --no-deps
