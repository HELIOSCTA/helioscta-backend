FROM prefecthq/prefect:3.6.22-python3.12

WORKDIR /app

# Install system dependencies for pyodbc
RUN apt-get update && apt-get install -y \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# Install pendulum binary wheel first to avoid build issues
RUN pip install --no-cache-dir pendulum --only-binary :all:

COPY requirements.txt .
# Strip the local-only transformations section (sqlmesh, duckdb) before
# install — the scrapes runtime does not call them and the image stays
# leaner without them. The marker is a fixed string in requirements.txt.
RUN sed '/transformations (local-only/,$d' requirements.txt > requirements.runtime.txt \
    && pip install --no-cache-dir -r requirements.runtime.txt

COPY . .

RUN pip install -e . --no-deps