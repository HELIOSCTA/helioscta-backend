# Local-only Terraform state and providers. Migrate to an Azure Storage
# backend in a follow-up by adding `backend "azurerm"` to versions.tf.
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
crash.log
crash.*.log

# Variable files containing secrets — pass via TF_VAR_* env vars instead.
*.tfvars
*.tfvars.json
!example.tfvars
